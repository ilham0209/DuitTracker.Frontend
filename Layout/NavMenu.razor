@inject MenuService MenuService
@inject NavigationManager Navigation

<MudNavMenu Class="pa-3" Style="height: 100%; display: flex; flex-direction: column;">
    <MudStack AlignItems="AlignItems.Center" Row="true" Class="px-2 py-4 mb-2">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6" Style="font-weight: 800; letter-spacing: -0.5px;">DuitTracker</MudText>
    </MudStack>

    <MudDivider Class="mb-3" />

    @foreach (var menuSection in _sections)
    {
        <MudText Typo="Typo.overline" Class="px-3 mb-1 mt-2" Style="opacity: 0.5; font-size: 0.65rem; letter-spacing: 1.5px;">
            @menuSection.Title
        </MudText>

        @foreach (var item in menuSection.Items)
        {
            <MudNavLink Href="@item.Href"
                        Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                        Icon="@item.Icon"
                        Class="rounded-lg mb-1"
                        Style="border-radius: 10px;">
                @item.Title
            </MudNavLink>
        }

        <MudDivider Class="my-2" />
    }
</MudNavMenu>

@code {
    private List<MenuSection> _sections = new();

    protected override void OnInitialized()
    {
        _sections = MenuService.GetMenuSections();
    }
}