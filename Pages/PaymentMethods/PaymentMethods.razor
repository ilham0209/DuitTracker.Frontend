@page "/payment-methods"
@inject PaymentMethodService PaymentMethodService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Payment Methods — DuitTracker</PageTitle>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700; margin-bottom:4px;">Payment Methods</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Manage your payment methods</MudText>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialogAsync"
               Style="border-radius:10px; font-weight:600;">
        Add Payment Method
    </MudButton>
</div>

@if (_loading)
{
    <div style="display:flex; justify-content:center; padding:80px 0;">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (_paymentMethods?.Count == 0)
{
    <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:80px 0; gap:12px;">
        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Style="font-size:56px; color:var(--mud-palette-text-secondary);" />
        <MudText Typo="Typo.body1" Style="color:var(--mud-palette-text-secondary);">No payment methods yet</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialogAsync">Add your first payment method</MudButton>
    </div>
}
else
{
    <div style="background:var(--mud-palette-surface); border-radius:12px; border:1px solid var(--mud-palette-divider);">
        <MudTable Items="_paymentMethods" Hover="true" Elevation="0" Dense="false">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <div style="display:flex; align-items:center; gap:12px;">
                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Style="color:var(--mud-palette-text-secondary);" />
                        <MudText Typo="Typo.body2" Style="font-weight:500;">@context.Name</MudText>
                    </div>
                </MudTd>
                <MudTd Style="text-align:right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => OpenEditDialogAsync(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="() => DeleteAsync(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
}

@code {
    private List<PaymentMethodResponse>? _paymentMethods;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _paymentMethods = await PaymentMethodService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<CreatePaymentMethodDialog>("Add Payment Method");
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OpenEditDialogAsync(PaymentMethodResponse paymentMethod)
    {
        var parameters = new DialogParameters { ["PaymentMethod"] = paymentMethod };
        var dialog = await DialogService.ShowAsync<EditPaymentMethodDialog>("Edit Payment Method", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task DeleteAsync(PaymentMethodResponse paymentMethod)
    {
        var parameters = new DialogParameters
        {
            ["Message"] = $"Are you sure you want to delete \"{paymentMethod.Name}\"?"
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Payment Method", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        try
        {
            await PaymentMethodService.DeleteAsync(paymentMethod.Id);
            Snackbar.Add("Payment method deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}