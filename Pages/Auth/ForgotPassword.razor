@page "/forgot-password"
@layout AuthLayout
@inject AuthService AuthService
@inject ISnackbar Snackbar

<PageTitle>Forgot Password — DuitTracker</PageTitle>

@if (!_emailSent)
{
    <MudText Typo="Typo.h5" Style="font-weight:700; color:#E0E0E0; margin-bottom:4px;">Forgot password?</MudText>
    <MudText Typo="Typo.body2" Style="color:#A0A0B0; margin-bottom:32px;">Enter your email and we'll send a reset link.</MudText>

    <MudForm @ref="_form" @bind-IsValid="_isValid">

        <MudTextField T="string"
                      @bind-Value="_request.Email"
                      Label="Email"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="Email is required."
                      Style="margin-bottom:24px;" />

        <MudButton FullWidth="true"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   OnClick="HandleSubmitAsync"
                   Disabled="_loading"
                   Style="border-radius:10px; font-weight:600; height:48px; margin-bottom:20px;">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="margin-right:8px;" />
            }
            Send Reset Link
        </MudButton>

    </MudForm>
}
else
{
    <div style="text-align:center; padding:16px 0;">
        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Style="font-size:56px; color:#4CAF50; margin-bottom:16px;" />
        <MudText Typo="Typo.h6" Style="color:#E0E0E0; margin-bottom:8px;">Check your email</MudText>
        <MudText Typo="Typo.body2" Style="color:#A0A0B0; margin-bottom:32px;">
            If an account exists for <strong style="color:#E0E0E0;">@_request.Email</strong>, a reset link has been sent.
        </MudText>
    </div>
}

<MudText Typo="Typo.body2" Align="Align.Center" Style="color:#A0A0B0;">
    Remember your password?
    <MudLink Href="/login" Style="color:#4CAF50; font-weight:600;">Sign in</MudLink>
</MudText>

@code {
    private MudForm _form = null!;
    private ForgotPasswordRequest _request = new();
    private bool _isValid;
    private bool _loading;
    private bool _emailSent;

    private async Task HandleSubmitAsync()
    {
        await _form.Validate();
        if (!_isValid) return;

        _loading = true;

        try
        {
            await AuthService.ForgotPasswordAsync(_request);
            _emailSent = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}